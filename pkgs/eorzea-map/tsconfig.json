{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["vite/client"],
    "declaration": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
